// delta_receiver_enhanced.go - Robust Continuous Receiver with SplitMuxSink
//go:build receiver

package main

import (
	"flag"
	"fmt"
	"os"
	"os/exec"
	"os/signal"
	"path/filepath"
	"strconv"
	"strings"
	"syscall"
	"time"
)

func main() {
	fmt.Println(" RTSP DELTA RECEIVER - Continuous Stream Saver")

	var (
		srtURI     string
		outputDir  string
		filename   string
		buffer     int
		chunkTime  int
		maxChunks  int
		display    bool
		saveChunks bool
		help       bool
	)

	flag.StringVar(&srtURI, "srt", "", "SRT listen URI (e.g., srt://:9000)")
	flag.StringVar(&outputDir, "output", "./received", "Output directory")
	flag.StringVar(&filename, "filename", "chunk", "Filename prefix")
	flag.IntVar(&buffer, "buffer", 120, "SRT buffer in ms")
	flag.IntVar(&chunkTime, "chunk-time", 30, "Chunk duration in seconds")
	flag.IntVar(&maxChunks, "max-chunks", 0, "Maximum number of chunks (0=unlimited)")
	flag.BoolVar(&display, "display", false, "Display video while receiving")
	flag.BoolVar(&saveChunks, "save-chunks", true, "Save video chunks")
	flag.BoolVar(&help, "help", false, "Show help")

	flag.Parse()

	if help {
		fmt.Printf("Usage: %s --srt srt://:9000 [options]\n", os.Args[0])
		return
	}

	if srtURI == "" {
		fmt.Fprintf(os.Stderr, "Error: --srt is required\n")
		os.Exit(1)
	}

	port := extractPort(srtURI)

	// Create output directory
	if err := os.MkdirAll(outputDir, 0755); err != nil {
		fmt.Printf("Error creating directory: %v\n", err)
		os.Exit(1)
	}

	// Clean up previous partial files if necessary? No, let's keep them or maybe warn.
	// For now, we just start.

	fmt.Println("\n=== RECEIVER CONFIG ===")
	fmt.Printf("Port:        %d\n", port)
	fmt.Printf("Buffer:      %d ms\n", buffer)
	fmt.Printf("Chunk Time:  %d seconds\n", chunkTime)
	fmt.Printf("Output:      %s\n", outputDir)

	// Start monitoring in background
	go monitorOutputFiles(outputDir, filename, chunkTime)

	runContinuousReceiver(port, buffer, outputDir, filename, chunkTime, maxChunks, display, saveChunks)
}

func extractPort(srtURI string) int {
	if strings.Contains(srtURI, ":") {
		parts := strings.Split(srtURI, ":")
		if len(parts) > 0 {
			portStr := parts[len(parts)-1]
			if port, err := strconv.Atoi(portStr); err == nil {
				return port
			}
		}
	}
	return 9000
}

func runContinuousReceiver(port, buffer int, outputDir, filename string, chunkTime, maxChunks int, display, saveChunks bool) {
	fmt.Println("\n=== STARTING CONTINUOUS RECEIVER ===")

	// Construct the location pattern for splitmuxsink
	// It uses printf style formatting, e.g. chunk_%05d.mp4
	filePattern := filepath.Join(outputDir, fmt.Sprintf("%s_%%05d.mp4", filename))

	// Convert chunkTime to nanoseconds
	nanos := int64(chunkTime) * 1000 * 1000 * 1000

	var pipeline string

	srtSource := fmt.Sprintf("srtsrc uri=\"srt://:%d?mode=listener&latency=%d\" wait-for-connection=true ! queue ! tsdemux name=demux ", port, buffer)

	fileSinkPart := ""
	if saveChunks {
		fileSinkPart = fmt.Sprintf("demux. ! queue ! h264parse ! splitmuxsink location=\"%s\" max-size-time=%d muxer=mp4mux ", filePattern, nanos)
	} else {
		fileSinkPart = "demux. ! queue ! fakesink "
	}

	displayPart := ""
	if display {
		displayPart = "demux. ! queue ! h264parse ! avdec_h264 ! videoconvert ! videoscale ! video/x-raw,width=640,height=360 ! autovideosink sync=false "
	}

	pipeline = fmt.Sprintf("gst-launch-1.0 -e %s %s %s", srtSource, fileSinkPart, displayPart)

	fmt.Printf("Pipeline: %s\n", pipeline)

	cmd := exec.Command("bash", "-c", pipeline)
	cmd.Stdout = os.Stdout
	cmd.Stderr = os.Stderr

	if err := cmd.Start(); err != nil {
		fmt.Printf("Failed to start receiver: %v\n", err)
		return
	}

	cmd.Stdout = os.Stdout
	cmd.Stderr = os.Stderr

	if err := cmd.Start(); err != nil {
		fmt.Printf("Failed to start receiver: %v\n", err)
		return
	}

	fmt.Println("Receiver running... Press Ctrl+C to stop.")

	// Wait for signal
	sigChan := make(chan os.Signal, 1)
	signal.Notify(sigChan, syscall.SIGINT, syscall.SIGTERM)

	// Wait for process to finish or signal
	done := make(chan error, 1)
	go func() {
		done <- cmd.Wait()
	}()

	select {
	case <-sigChan:
		fmt.Println("\nStopping receiver...")
		// Send SIGINT to GStreamer to allow proper EOS and file finalization
		cmd.Process.Signal(syscall.SIGINT)

		// Wait a bit for graceful shutdown
		select {
		case <-done:
			fmt.Println("Receiver stopped gracefully.")
		case <-time.After(5 * time.Second):
			fmt.Println("Receiver unresponsive, force killing...")
			cmd.Process.Kill()
		}
	case err := <-done:
		if err != nil {
			fmt.Printf("Receiver exited with error: %v\n", err)
		} else {
			fmt.Println("Receiver exited normally.")
		}
	}
}

func monitorOutputFiles(dir, prefix string, chunkTime int) {
	// Simple monitor: check for new files periodically
	// "splitmuxsink" creates files sequentially: chunk_00000.mp4, chunk_00001.mp4...
	// When chunk_N+1 exists, chunk_N is definitely done.

	nextIndex := 0
	ticker := time.NewTicker(2 * time.Second)
	defer ticker.Stop()

	for range ticker.C {
		// Check if current expected file exists
		currentFile := fmt.Sprintf("%s_%05d.mp4", prefix, nextIndex)
		currentPath := filepath.Join(dir, currentFile)

		// Check if the NEXT file exists (meaning current is done)
		nextFile := fmt.Sprintf("%s_%05d.mp4", prefix, nextIndex+1)
		nextPath := filepath.Join(dir, nextFile)

		if _, err := os.Stat(nextPath); err == nil {
			// Next file exists, so current file is complete
			printFileStats(currentPath, chunkTime)
			nextIndex++
		}
	}
}

func printFileStats(path string, expectedDuration int) {
	info, err := os.Stat(path)
	if err != nil {
		return
	}

	sizeMB := float64(info.Size()) / (1024 * 1024)

	// Try to get duration/frames via ffprobe if available
	frames := 0
	duration := 0.0

	// Quick check with ffprobe
	cmd := fmt.Sprintf("ffprobe -v error -select_streams v:0 -show_entries stream=nb_frames,duration -of csv=p=0 \"%s\"", path)
	out, err := exec.Command("bash", "-c", cmd).Output()
	if err == nil {
		parts := strings.Split(strings.TrimSpace(string(out)), ",")
		if len(parts) >= 2 {
			if f, err := strconv.Atoi(parts[0]); err == nil {
				frames = f
			}
			if d, err := strconv.ParseFloat(parts[1], 64); err == nil {
				duration = d
			}
		}
	}

	// Fallback estimation if ffprobe fails or returns N/A (common for live streams)
	if duration == 0 {
		duration = float64(expectedDuration) // approximate
	}
	if frames == 0 {
		// Estimate based on 15fps default
		frames = int(duration * 15)
	}

	fmt.Printf("\n>>> Chunk Saved: %s\n", filepath.Base(path))
	fmt.Printf("    Size:     %.2f MB\n", sizeMB)
	fmt.Printf("    Duration: %.2f s\n", duration)
	fmt.Printf("    Frames:   %d\n", frames)
}

